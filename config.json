{
  // 上传文件访问签名有效期（秒），默认 7 天
  "uploadUrlExpiresSec": 604800,
  // 上传签名密钥（留空自动生成保存到 data/.upload-secret）
  "uploadSecret": "",
  /* ============================================================
     Z80Z-chat 部署配置文件
     ------------------------------------------------------------
     本文件可用记事本直接打开编辑，保存后运行部署脚本生效：
       Windows: 双击 start.bat 或执行 node start.js
     ------------------------------------------------------------
     修改规则：
       1. 每项配置前都有详细的注释说明，请先阅读注释再修改
       2. 注释行（以 // 或 /* 开头的内容）不会影响程序运行
       3. 引号必须是英文双引号 "，字符串用英文双引号包裹
       4. 每个键值对之间用英文逗号 , 分隔，最后一项不能加逗号
       5. 修改端口 / 监听地址后，必须重启服务才能生效
       6. 如果改坏了导致无法启动，可直接删除本文件，
          程序会自动使用内置默认值重新创建一份
      ============================================================ */

  /* ------------------------------------------------------------
     网站显示名称
     ------------------------------------------------------------
     作用：项目在界面各处显示的名称（浏览器标题、登录/注册页、
           控制台横幅、部署脚本头部与菜单等）
     示例：
       "Z80Z-chat"  → 默认名称
       "我的聊天"  → 自定义名称（支持中文）
     注意：
       - 修改后需重启服务并重新构建前端（npm run build）才完全生效
       - 仅影响显示文案，不影响防火墙规则名、目录名等
     ------------------------------------------------------------ */
  "siteName": "Z80Z-chat",

  /* ------------------------------------------------------------
     服务端口号
     ------------------------------------------------------------
     作用：网站服务的监听端口，浏览器通过端口访问本系统
     示例：
       3000   → http://192.168.1.100:3000
       80     → http://192.168.1.100（80 为网页默认端口，无需写）
       8080   → http://192.168.1.100:8080
     注意：
       - 范围 1~65535，建议使用 1024 以上的端口避免权限问题
       - 80 端口在部分系统上需要管理员权限
       - 修改后防火墙规则会由部署脚本自动同步更新
     ------------------------------------------------------------ */
  "port": 3000,

  /* ------------------------------------------------------------
     监听地址
     ------------------------------------------------------------
     作用：决定哪些网络可以访问本服务
     可选值：
       0.0.0.0    → 监听所有网卡，局域网/公网都能访问（推荐）
       127.0.0.1  → 仅本机可以访问，其他人无法访问
       192.168.x.x → 只允许局域网指定 IP 访问
     注意：
       - 部署到服务器或想让手机/其他电脑访问，请保持 0.0.0.0
       - 仅自己测试时可改为 127.0.0.1 提高安全性
     ------------------------------------------------------------ */
  "host": "0.0.0.0",

  /* ------------------------------------------------------------
     数据目录
     ------------------------------------------------------------
     作用：存放所有运行数据的根目录（相对项目根目录）
     内容：包含数据库文件、上传的图片/文件等
     注意：
       - 备份数据 = 备份这个目录下的内容
       - 路径相对于项目根目录，一般无需修改
     ------------------------------------------------------------ */
  "dataDir": "data",

  /* ------------------------------------------------------------
     数据库文件名
     ------------------------------------------------------------
     作用：主数据库文件名，存储用户/服务器/频道/消息等全部数据
     注意：为 JSON 文件，可直接用记事本查看（不建议手动改）
     ------------------------------------------------------------ */
  "dbFile": "db.json",

  /* ------------------------------------------------------------
     上传文件目录名
     ------------------------------------------------------------
     作用：存放用户上传的图片和文件的目录（相对数据目录）
     注意：目录名修改后，旧的已上传文件不会自动迁移
     ------------------------------------------------------------ */
  "uploadDir": "uploads",

  /* ------------------------------------------------------------
     单个文件上传大小上限（单位：MB）
     ------------------------------------------------------------
     作用：限制每次上传的单个文件最大体积
     示例：10 表示最多 10MB，100 表示最多 100MB
     注意：过大可能导致上传卡顿或占满磁盘，请按需设置
     ------------------------------------------------------------ */
  "maxUploadSizeMB": 10,

  /* ------------------------------------------------------------
     允许上传的文件类型（管道符 | 分隔的扩展名白名单）
     ------------------------------------------------------------
     作用：只有列出的扩展名允许上传，其余会被拒绝
     注意：如需开放更多类型，直接在竖线间追加扩展名即可
     ------------------------------------------------------------ */
  "allowedUploadTypes": "jpeg|jpg|png|gif|webp|mp4|mp3|pdf|zip|txt|doc|docx",

  /* ------------------------------------------------------------
     请求体大小上限（单位：MB）
     ------------------------------------------------------------
     作用：单次 API 请求体的最大体积（JSON 数据、大文本消息等）
     注意：一般无需修改，上传文件大小由上面 maxUploadSizeMB 控制
     ------------------------------------------------------------ */
  "bodyLimitMB": 50,

  /* ------------------------------------------------------------
     跨域白名单（CORS）
     ------------------------------------------------------------
     作用：允许哪些来源的网页调用本服务 API
     可选值：
       "*"         → 允许所有来源（部署在同服务器同端口时可保持）
       "http://a.com,http://b.com" → 只允许列出的来源
     注意：前后端同端口部署（本项目默认方式）时用 * 即可
     ------------------------------------------------------------ */
  "corsOrigins": "*",

  /* ------------------------------------------------------------
     WebSocket 服务路径
     ------------------------------------------------------------
     作用：实时通信（消息推送/语音信令）的连接路径
     注意：除非路径冲突，否则保持默认即可，不要随意修改
     ------------------------------------------------------------ */
  "wsPath": "/ws",

  /* ------------------------------------------------------------
     WebRTC 语音/投屏的 ICE 服务器列表
     ------------------------------------------------------------
     作用：帮助不同网络（如手机 4G 与电脑局域网）之间建立
           点对点语音/投屏连接
     说明：
       - 默认使用 Google 公共 STUN 服务器（需能访问外网）
       - 若部署在纯内网（无外网），可将 urls 换成内网自建
         STUN/TURN 服务器地址，例如：
         { "urls": "stun:192.168.1.100:3478" }
       - 可以配置多个，按顺序逐个尝试
     ------------------------------------------------------------ */
  "iceServers": [
    {
      "urls": "stun:stun.l.google.com:19302"
    }
  ],

  /* ------------------------------------------------------------
     防火墙规则配置（Windows 部署自动应用）
     ------------------------------------------------------------
     enabled：是否在部署时自动添加 Windows 防火墙入站规则
              true  → 自动添加（弹 UAC 管理员授权窗口，点"是"）
              false → 跳过防火墙配置（需手动放行，否则其他
                      设备无法访问本服务）
     ruleName：防火墙规则名称（自定义，用于识别和删除本规则）
     ------------------------------------------------------------ */
  "firewall": {
    "enabled": true,
    "ruleName": "Z80Z-chat"
  },

  /* ------------------------------------------------------------
     数据备份保留份数（单文件部署模式）
     ------------------------------------------------------------
     作用：更新流程与「备份管理」自动清理旧备份时保留的份数
     示例：3 → 最多保留最近 3 份备份，更早的自动删除
     注意：在 1 到 10 之间，太小可能导致无可用回滚备份
     ------------------------------------------------------------ */
  "backupKeep": 3,

  /* ------------------------------------------------------------
     Node.js 主版本号（单文件部署模式自动下载时使用）
     ------------------------------------------------------------
     作用：引导安装程序自动下载 Node.js 时使用的版本
     示例："22" → 下载 Node 22.x 最新版
     注意：Windows 8.1 及以下会自动回退到 18.x
     ------------------------------------------------------------ */
  "nodeVersion": "22",

  /* ------------------------------------------------------------
     Node.js 下载镜像地址（单文件部署模式自动记录）
     ------------------------------------------------------------
     作用：安装时选择线路后自动写入，后续更新重复使用
     示例："https://npmmirror.com/mirrors/node"
     注意：留空表示未记录，下次安装会重新测速选择
     ------------------------------------------------------------ */
  "nodeMirror": "https://repo.huaweicloud.com/nodejs",

  /* ------------------------------------------------------------
     npm 包镜像地址（单文件部署模式自动记录）
     ------------------------------------------------------------
     作用：安装依赖时使用的 npm 镜像源，安装时选择线路后自动写入
     示例："https://registry.npmmirror.com"
     注意：留空表示未记录，使用默认 npmmirror
     ------------------------------------------------------------ */
  "npmRegistry": "https://repo.huaweicloud.com/repository/npm/"
}