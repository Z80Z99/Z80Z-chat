{
  "name": "z80z-chat",
  "version": "1.0.9",
  "description": "Discord-style community chat app - 100% local, zero external dependencies",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --config frontend/vite.config.ts\" \"node server.js\"",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.node.json",
    "check:frontend": "npm run typecheck && npm run build && node frontend/scripts/check-art.mjs",
    "start": "npm run build && node server.js",
    "test": "node --test --test-concurrency=1",
    "backup": "node scripts/backup.js",
    "build:single": "node scripts/build-single.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "pinia": "^2.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vue-tsc": "3.3.13"
  }
}
